{
  "model": "opus",
  "autoMemoryEnabled": false,
  "disableClaudeAiConnectors": true,
  "env": {
    "HTTPS_PROXY": "http://10.0.2.2:10809",
    "HTTP_PROXY": "http://10.0.2.2:10809",
    "NO_PROXY": "localhost,127.0.0.1"
  },
  "includeGitInstructions": false,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "~/.cache",
        "~/.cargo",
        "~/.rustup",
        "~/go"
      ]
    }
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "WebFetch(domain:*)"
    ]
  }
}
